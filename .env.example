# ╭────────────────────────────────────────────
# │  ATLAS BOT · CONFIGURACIÓN
# │  Copia este archivo como ".env" y edítalo:
# │     cp .env.example .env
# ╰────────────────────────────────────────────

# » Nombre del bot (aparece en el menú y en los mensajes)
BOT_NAME=Atlas Bot

# » Nombre del dueño (solo informativo, se muestra en el menú)
OWNER_NAME=Lyan

# » Número del dueño con código de país, sin "+" ni espacios.
#   Puedes agregar varios separados por comas:
#   OWNER_NUMBER=59896719709,59896719709
OWNER_NUMBER=59896719709

# » Prefijo de los comandos.
#   Un solo carácter (PREFIX=!) o varios a la vez (PREFIX=!./)
PREFIX=!

# » Método de conexión: "qr" o "pairing"
#   Déjalo vacío y el bot te PREGUNTARÁ al iniciar (recomendado).
#   También puedes usar: npm run start:qr  /  npm run start:pairing
CONNECTION_METHOD=

# » Número para el código de vinculación (solo si CONNECTION_METHOD=pairing)
#   Con código de país, sin "+" ni espacios.
#   Si se deja vacío, el bot lo preguntará en la consola al iniciar.
PAIRING_NUMBER=

# » Nombre de la carpeta donde se guarda la sesión de WhatsApp
SESSION_NAME=session

# » Tiempo de espera (en milisegundos) antes de intentar reconectar
RECONNECT_DELAY=3000

# » [Opcional] Inteligencia artificial para el comando !ia
#   Cualquier API compatible con OpenAI sirve (OpenAI, DeepSeek, Groq...).
#   También se puede configurar en config.js, sección "ai".
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
